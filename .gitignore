# ==== Java / Maven (backend) ====
backend/target/
*.class
*.log
dependency-reduced-pom.xml
# Maven wrapper: se versiona el .properties, no el jar descargado
.mvn/wrapper/maven-wrapper.jar
# Eclipse / STS
.classpath
.project
.settings/
.factorypath

# ==== Node / Vite / TypeScript (frontend) ====
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
*.tsbuildinfo
.eslintcache
# Logs de gestores de paquetes
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==== Variables de entorno ====
# Config local (incluye frontend/.env con VITE_USE_MOCK). Un .env.example
# de plantilla si se cablea SI puede versionarse.
.env
.env.local
.env.*.local
!.env.example
# Produccion: secretos reales (APP_MASTER_KEY, JWT, DB). NUNCA versionar;
# la plantilla .env.prod.example si se versiona.
.env.prod
.env.production
!.env.prod.example

# ==== Secretos (certificado digital + CAF) ====
# NUNCA versionar: certificado PKCS#12 del representante legal y CAF del SII.
secrets/
*.pfx
*.p12
# Excepcion: fixture SINTETICO de tests (autofirmado, RUN 11111111-1, clave
# "test123"). No es material real y no sirve ante el SII, pero sin el la suite
# no corre en un clon limpio (CI). El certificado real vive en secrets/.
!backend/src/test/resources/sii/cert_prueba.p12

# ==== Claude Code ====
# Config local del agente (incluye settings.local.json con las reglas de
# permiso de esta maquina). Es personal, no comportamiento del proyecto.
.claude/

# ==== IDE / editores ====
.idea/
.vscode/
*.iml
*.swp
*~

