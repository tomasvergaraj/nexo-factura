# Plantilla de variables de PRODUCCION. Copiar a .env.prod (gitignoreado) y
# rellenar con valores reales. Usar con:
#
#   docker compose -p nexo-prod --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# ============================================================================
#  APP_MASTER_KEY — clave maestra AES-256 (base64 de EXACTAMENTE 32 bytes).
#  Cifra en reposo los CAF y los PKCS#12 de cada empresa.
#
#  Generar (una sola vez):   openssl rand -base64 32
#
#  ⚠️  CRITICO: si se pierde, los CAF y certificados ya cifrados en la BD
#      quedan INDESCIFRABLES (no hay recuperacion). Respaldarla en un gestor
#      de secretos FUERA del repo. No puede ser la clave de desarrollo.
# ============================================================================
APP_MASTER_KEY=

# Secreto de firma de los JWT. Generar: openssl rand -base64 48
APP_JWT_SECRET=

# Password del usuario 'nexo' de la base de datos de produccion.
DB_PASSWORD=

# Origenes CORS permitidos (front de prod). Por defecto http://localhost:8084.
# APP_CORS_ORIGINS=http://localhost:8084
